# Copy this file to .env and fill in your Zerodha Kite Connect credentials
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# SAFETY INTERLOCK: live orders are placed ONLY when config.yaml mode=live
# AND this is set to exactly YES. Leave blank for paper trading.
KITE_LIVE_CONFIRM=
